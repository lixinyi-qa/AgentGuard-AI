{
  "info":{"name":"AgentGuard AI Sequential API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item":[
    {"name":"01 Health","request":{"method":"GET","url":"{{base_url}}/health"},"event":[{"listen":"test","script":{"exec":["pm.test('health ok',()=>pm.response.to.have.status(200));","pm.environment.set('request_id',pm.response.json().request_id);"]}}]},
    {"name":"02 Run Agent","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"user_input\":\"查询虚构账户 ACC-001\",\"user_role\":\"customer\",\"actor_id\":\"CUST-001\",\"target_object\":\"ACC-001\"}"},"url":"{{base_url}}/api/agent/run"},"event":[{"listen":"test","script":{"exec":["pm.test('agent success',()=>pm.expect(pm.response.json().success).to.be.true);","pm.environment.set('trace_id',pm.response.json().trace_id);"]}}]},
    {"name":"03 Trace Detail","request":{"method":"GET","url":"{{base_url}}/api/traces/{{trace_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('trace found',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"04 Replay Trace","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"mode\":\"original\",\"offline\":true}"},"url":"{{base_url}}/api/traces/{{trace_id}}/replay"},"event":[{"listen":"test","script":{"exec":["pm.test('replay has no side effects',()=>pm.expect(pm.response.json().trace.tool_events.every(e=>!e.side_effect)).to.be.true);"]}}]},
    {"name":"05 Create Fault","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"target_tool\":\"query_account\",\"fault_type\":\"timeout\",\"trigger_count\":1,\"enabled\":true}"},"url":"{{base_url}}/api/faults"},"event":[{"listen":"test","script":{"exec":["pm.test('fault created',()=>pm.response.to.have.status(201));","pm.environment.set('fault_id',pm.response.json().fault.fault_id);"]}}]},
    {"name":"06 Trigger Fault","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"user_input\":\"查询虚构账户 ACC-001\",\"user_role\":\"customer\",\"actor_id\":\"CUST-001\",\"target_object\":\"ACC-001\"}"},"url":"{{base_url}}/api/agent/run"},"event":[{"listen":"test","script":{"exec":["pm.test('retry recovered',()=>pm.expect(pm.response.json().tool_events.length).to.eql(2));"]}}]},
    {"name":"07 Delete Fault","request":{"method":"DELETE","url":"{{base_url}}/api/faults/{{fault_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('fault deleted',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"08 Baseline Evaluation","request":{"method":"POST","url":"{{base_url}}/api/evaluations/run"},"event":[{"listen":"test","script":{"exec":["pm.test('gate passes',()=>pm.expect(pm.response.json().run.quality_gate.status).to.eql('PASS'));","pm.environment.set('baseline_run_id',pm.response.json().run.run_id);","pm.environment.set('run_id',pm.response.json().run.run_id);"]}}]},
    {"name":"09 Candidate Evaluation","request":{"method":"POST","url":"{{base_url}}/api/evaluations/run"},"event":[{"listen":"test","script":{"exec":["pm.environment.set('candidate_run_id',pm.response.json().run.run_id);","pm.test('40 cases',()=>pm.expect(pm.response.json().run.results.length).to.eql(40));"]}}]},
    {"name":"10 Compare Runs","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"baseline_run_id\":\"{{baseline_run_id}}\",\"candidate_run_id\":\"{{candidate_run_id}}\"}"},"url":"{{base_url}}/api/evaluations/compare"},"event":[{"listen":"test","script":{"exec":["pm.test('no regression',()=>pm.expect(pm.response.json().comparison.regression_count).to.eql(0));"]}}]},
    {"name":"11 JSON Report","request":{"method":"GET","url":"{{base_url}}/api/reports/{{run_id}}.json"},"event":[{"listen":"test","script":{"exec":["pm.test('report exported',()=>pm.response.to.have.status(200));"]}}]}
  ]
}

