# Default mode needs no API key.
AGENTGUARD_PROVIDER=deterministic-local
AGENTGUARD_DATABASE_URL=sqlite:///data/agentguard.db
AGENTGUARD_PROMPT_VERSION=v1
AGENTGUARD_POLICY_VERSION=v1
AGENTGUARD_MAX_RETRIES=2

# Optional OpenAI Responses API provider. Never commit the real value.
# AGENTGUARD_PROVIDER=openai-compatible
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=

